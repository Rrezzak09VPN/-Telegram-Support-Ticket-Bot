# ============================================
# Support Bot Configuration
# Этот файл создаётся автоматически при установке.
# Для ручного редактирования: nano /opt/support-bot/config.env
# После изменений: systemctl restart support-bot
# ============================================

# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN="YOUR_BOT_TOKEN_HERE"

# ID группы с включёнными Темами (Topics)
# Бот должен быть админом в этой группе
GROUP_ID=-1001234567890

# ID администраторов (через запятую, если несколько)
ADMIN_IDS=123456789

# Название проекта (отображается в сообщениях бота)
PROJECT_NAME="🚀 Support Bot 🌐"

# === Лимиты ===
MAX_FILE_SIZE=20971520
MAX_OPEN_TICKETS=1
MAX_MESSAGES_PER_MINUTE=10

# === Пути ===
DATA_DIR="/opt/support-bot/data"

# === Логирование ===
# Максимальный размер одного лог-файла в МБ
MAX_LOG_SIZE_MB=50
# Количество ротируемых лог-файлов (всего = текущий + backup)
LOG_BACKUP_COUNT=5
